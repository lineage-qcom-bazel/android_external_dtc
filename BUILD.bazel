load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

COPTS = [
    "-Wall",
    "-Werror",
    "-Wno-macro-redefined",
    "-Wno-missing-field-initializers",
    "-Wno-sign-compare",
    "-Wno-unused-parameter",
]

# Explicit lists avoid glob + package-root lookup problems that cause
# "undeclared inclusion" errors in this tree.
LIBFDT_HDRS = [
    "libfdt/fdt.h",
    "libfdt/libacpi.h",
    "libfdt/libfdt.h",
    "libfdt/libfdt_env.h",
    "libfdt/libfdt_internal.h",
]

cc_library(
    name = "libfdt",
    srcs = [
        "libfdt/acpi.c",
        "libfdt/fdt.c",
        "libfdt/fdt_addresses.c",
        "libfdt/fdt_check.c",
        "libfdt/fdt_empty_tree.c",
        "libfdt/fdt_overlay.c",
        "libfdt/fdt_ro.c",
        "libfdt/fdt_rw.c",
        "libfdt/fdt_strerror.c",
        "libfdt/fdt_sw.c",
        "libfdt/fdt_wip.c",
    ] + LIBFDT_HDRS,
    hdrs = LIBFDT_HDRS,
    textual_hdrs = LIBFDT_HDRS,
    copts = COPTS + ["-Iexternal/dtc/libfdt"],
    includes = ["libfdt"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "dtc_lexer_srcs",
    srcs = ["dtc-lexer.l"],
    outs = ["dtc-lexer.lex.c"],
    cmd = "$(location //prebuilts/build-tools:flex) -o $@ $<",
    tools = ["//prebuilts/build-tools:flex"],
)

genrule(
    name = "dtc_parser_srcs",
    srcs = ["dtc-parser.y"],
    outs = [
        "dtc-parser.c",
        "dtc-parser.h",
    ],
    cmd = "$(location //prebuilts/build-tools:bison) -d -o $(location dtc-parser.c) $(location dtc-parser.y)",
    tools = [
        "//prebuilts/build-tools:bison",
    ],
)

UTILS = [
    "util.c",
]

# Rely on the check in Android.bp and build tests to catch any change in the
# format of version_gen.h.in.
genrule(
    name = "version_gen_header",
    srcs = ["VERSION.txt"],
    outs = ["version_gen.h"],
    cmd = """
        # Avoid accessing host tools.
        export PATH=
        read -r version < $<
        echo "#define DTC_VERSION \\"DTC $${version}-Android-build\\"" > $@
    """,
)

cc_library(
    name = "util_hdrs",
    hdrs = [
        "util.h",
        ":version_gen_header",
    ],
    includes = ["."],
)

cc_library(
    name = "dtc_hdrs",
    hdrs = [
        "dtc.h",
        "srcpos.h",
        ":dtc_parser_srcs",
    ],
    includes = ["."],
)

cc_binary(
    name = "dtc",
    srcs = UTILS + [
        "checks.c",
        "data.c",
        "dtc.c",
        "flattree.c",
        "fstree.c",
        "livetree.c",
        "srcpos.c",
        "treesource.c",
        ":dtc_lexer_srcs",
        ":dtc_parser_srcs",
    ],
    copts = COPTS,
    defines = ["NO_YAML"],
    visibility = [
        "@kleaf//build/kernel:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        ":dtc_hdrs",
        ":libfdt",
        ":util_hdrs",
    ],
)

cc_binary(
    name = "fdtget",
    srcs = UTILS + [
        "fdtget.c",
    ],
    copts = COPTS,
    defines = ["NO_YAML"],
    visibility = [
        "@kleaf//build/kernel:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        ":libfdt",
        ":util_hdrs",
    ],
)

cc_binary(
    name = "fdtput",
    srcs = UTILS + [
        "fdtput.c",
    ],
    copts = COPTS,
    defines = ["NO_YAML"],
    visibility = [
        "@kleaf//build/kernel:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        ":libfdt",
        ":util_hdrs",
    ],
)

cc_binary(
    name = "fdtdump",
    srcs = UTILS + [
        "fdtdump.c",
    ],
    copts = COPTS,
    defines = ["NO_YAML"],
    deps = [
        ":libfdt",
        ":util_hdrs",
    ],
)

cc_binary(
    name = "fdtoverlay",
    srcs = UTILS + [
        "fdtoverlay.c",
    ],
    copts = COPTS,
    defines = ["NO_YAML"],
    visibility = [
        "@kleaf//build/kernel:__subpackages__",
        "//vendor:__subpackages__",
    ],
    deps = [
        ":libfdt",
        ":util_hdrs",
    ],
)
